# Copy these variables into your hosting provider's dashboard.
# Generate a fresh secret for every deployment; do not reuse the local reference value.
# Example generator: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

APP_JWT_SECRET=<generate-a-32-plus-character-secret>
APP_SEED_ENABLED=false
CORS_ALLOWED_ORIGINS=https://diskart.vercel.app

SPRING_DATASOURCE_URL=jdbc:mysql://<host>:3306/<database>?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=<user>
SPRING_DATASOURCE_PASSWORD=<password>

PORT=8080
